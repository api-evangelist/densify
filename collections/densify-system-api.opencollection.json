{
  "opencollection": "1.0.0",
  "info": {
    "name": "Densify / Kubex Public Cloud Authentication System API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Connectivity check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.densify.com/CIRBA/api/v2/ping"
          },
          "docs": "Verify the API subsystem is reachable."
        }
      ]
    }
  ],
  "bundled": true
}